{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "installCommand": "echo \"Skipping dependency install; static exporter uses Node built-ins only\"",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
